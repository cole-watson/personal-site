# Copy to .env.local for development; set the same keys in Vercel → Project → Settings → Environment Variables.

# Canonical URL, used for Open Graph/metadata. e.g. https://colewatson.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (https://resend.com → API Keys)
RESEND_API_KEY=
# Where messages are delivered
CONTACT_TO_EMAIL=cole.j.watson@gmail.com
# Must be on a domain verified in Resend. Until then, onboarding@resend.dev only delivers to your Resend account email.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
